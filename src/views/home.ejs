<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

  <!-- Icons -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  />

  <link rel="stylesheet" href="home.css" />
</head>

<body>
  <div class="admin-hero">
    <div class="admin-card">
      <% if (member) { %>
      <!-- LOGGED IN -->
      <h1>Admin Panel</h1>
      <p class="subtitle">Natural Home Decor Management</p>

      <ul class="admin-actions">
        <li class="fade-item">
          <a href="/admin/product/all">
            <i class="fa-solid fa-couch"></i> Products
          </a>
        </li>

        <li class="fade-item">
          <a href="/admin/product/all?create=true">
            <i class="fa-solid fa-plus"></i> Create New Product
          </a>
          
        </li>

        <li class="fade-item">
          <a href="/admin/user/all">
            <i class="fa-solid fa-users"></i> Users
          </a>
        </li>

        <li class="fade-item">
          <a
            href="/admin/logout"
            class="logout-btn"
            onclick="return confirm('Do you want to logout?')"
          >
            <i class="fa-solid fa-door-open"></i> Logout
          </a>
        </li>
      </ul>

      <% } else { %>
      <!-- NOT LOGGED IN -->
      <h1>Welcome</h1>
      <p class="subtitle">Please login to access admin panel</p>

      <ul class="admin-actions">
        <li class="fade-item">
          <a href="/admin/login">
            <i class="fa-solid fa-right-to-bracket"></i> Login
          </a>
        </li>

        <li class="fade-item">
          <a href="/admin/signup">
            <i class="fa-solid fa-user-plus"></i> Signup
          </a>
        </li>
      </ul>
      <% } %>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
