<%- include('includes/header') %>

<body>
  <div class="admin-hero">
    <div class="admin-card">
      <% if (member) { %>
      <!-- LOGGED IN -->
      <span class="hd-wordmark hd-wordmark--sm">Home Decor</span>
      <p class="subtitle">Natural Home Decor — Admin Management</p>

      <ul class="admin-actions">
        <li>
          <a href="/admin/product/all">Products</a>
        </li>
        <li>
          <a href="/admin/product/all?create=true">Create New Product</a>
        </li>
        <li>
          <a href="/admin/user/all">Users</a>
        </li>
        <li>
          <a
            href="/admin/logout"
            class="logout-btn"
            onclick="return confirm('Do you want to logout?')"
            >Logout</a
          >
        </li>
      </ul>

      <% } else { %>
      <!-- NOT LOGGED IN -->
      <span class="hd-wordmark hd-wordmark--sm">Home Decor</span>
      <p class="subtitle">Please login to access the admin panel</p>

      <ul class="admin-actions">
        <li>
          <a href="/admin/login">Login</a>
        </li>
        <li>
          <a href="/admin/signup">Signup</a>
        </li>
      </ul>
      <% } %>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
