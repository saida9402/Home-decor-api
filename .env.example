# MongoDB connection string (mongodb+srv://user:password@cluster/dbname)
MONGO_URL=
# Secret used to sign express-session cookies
SESSION_SECRET=
# Secret used to sign JWT auth tokens
SECRET_TOKEN=
# Port the API server listens on
PORT=
# Google Gemini API key for the AI recommendation endpoint (POST /ai/recommend)
GEMINI_API_KEY=your-gemini-api-key-here
